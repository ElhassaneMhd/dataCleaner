# Server Configuration
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
BODY_LIMIT_MB=500
CORS_ORIGINS=*

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=datacleaner
DB_SSLMODE=disable

# Redis Configuration (Optional - for caching)
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Cache TTL (Time To Live in seconds)
DNS_CACHE_TTL=3600
MX_CACHE_TTL=3600

# Validation Configuration
VALIDATOR_CONCURRENCY=1000
VALIDATOR_TIMEOUT_SECONDS=3
VALIDATOR_MAX_RETRIES=2
VALIDATOR_RETRY_DELAY_MS=500

# SMTP Verification VPS (for email existence checking)
VERIFY_VPS_HOST=
VERIFY_VPS_PORT=25
VERIFY_FROM_EMAIL=verify@datacleaner.local
VERIFY_HELO_HOSTNAME=datacleaner.local
VERIFY_ENABLED=false
BYPASS_BLACKLIST=true

# Sending SMTP (for actual email sending tests)
SENDING_HOST=
SENDING_PORT=587
SENDING_USERNAME=
SENDING_PASSWORD=
SENDING_FROM_EMAIL=
SENDING_TEST_ENABLED=false

# JWT Authentication
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_EXPIRY_HOURS=24

# File Upload
MAX_FILE_SIZE_MB=500
ALLOWED_FILE_EXTENSIONS=.csv,.xlsx,.xls

# Cleanup Configuration
CLEANUP_ENABLED=true
CLEANUP_INTERVAL_HOURS=24
CLEANUP_RETENTION_DAYS=7

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Environment
ENV=development
